# Copy this file to .streamlit/secrets.toml (LOCAL) and fill in your real key.
# When deploying to Streamlit Community Cloud, paste this same content into
# the app's "Secrets" settings panel instead of committing a real file.
#
# Get a free key at https://aistudio.google.com/apikey

# KEEP THE QUOTES. This is TOML: an unquoted value fails to parse and
# Streamlit falls back to mock mode without telling you why.

GEMINI_API_KEY = "your-key-here"
